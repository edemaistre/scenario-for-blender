x":1,"min":0.01,"name":"imageStrength","costImpact":false,"step":0.01,"type":"number"},{"description":"A black-and-white mask for inpainting. White regions are regenerated, black regions are preserved. Requires an input image.","group":"Reference Image","kind":"image","label":"Mask","name":"mask","costImpact":false,"parent":true,"type":"file","maskFrom":"image"},{"description":"Output width in pixels. Upscaling applies to PBR maps only, not the base texture.","default":1024,"group":"Settings","label":"Width","max":2048,"min":512,"name":"width","costImpact":true,"step":16,"type":"number"},{"description":"Output height in pixels. Upscaling applies to PBR maps only, not the base texture.","default":1024,"group":"Settings","label":"Height","max":2048,"min":512,"name":"height","costImpact":true,"step":16,"type":"number"},{"allowedValues":["basecolor","normal","roughness","metalness","height"],"description":"Which PBR maps to predict. Deselect all to skip PBR estimation and only generate the texture.","default":["basecolor","normal","roughness","metalness","height"],"group":"Settings","label":"Maps","maxLength":5,"name":"maps","costImpact":true,"type":"string_array"},{"allowedValues":[0,2,4],"description":"Seamless upscale for predicted PBR maps. 0 keeps map resolution, 2 doubles it, 4 quadruples it (up to 8K from a 2048 texture). The base texture is not upscaled.","default":0,"group":"Settings","label":"Upscale Factor","name":"upscaleFactor","costImpact":true,"type":"number"},{"allowedValues":["both","horizontal","vertical"],"description":"Which directions the material repeats seamlessly. Both repeats in every direction; Horizontal repeats left-to-right; Vertical repeats top-to-bottom.","default":"both","group":"Settings","label":"Tiling Mode","name":"tilingMode","costImpact":false,"type":"string"},{"description":"Number of texture images to generate from the same prompt.","default":1,"group":"Settings","label":"Image Count","max":4,"min":1,"name":"numOutputs","costImpact":true,"step":1,"type":"number"},{"description":"Number of denoising steps for texture generation. Higher values take longer.","default":8,"group":"Settings","label":"Inference Steps","max":8,"min":1,"name":"numInferenceSteps","costImpact":false,"step":1,"type":"number"},{"description":"Expand the prompt with an LLM for richer material detail.","default":true,"group":"Settings","label":"Enable Prompt Expansion","name":"enablePromptExpansion","costImpact":false,"type":"boolean"},{"description":"Seamless-tiling window in latent space. 64 ≈ 512px, 128 ≈ 1024px, 256 ≈ 2048px. Match this to the output resolution for cleaner repeats.","default":128,"group":"Settings","label":"Tile Size","max":256,"min":32,"name":"tileSize","costImpact":false,"step":1,"type":"number"},{"description":"How far the tiling window steps between passes. Smaller than tile size adds overlap and usually smoother seams; larger is faster but can show a grid.","default":64,"group":"Settings","label":"Tile Stride","max":128,"min":16,"name":"tileStride","costImpact":false,"step":1,"type":"number"},{"description":"A number that makes results repeatable. Reusing the same seed and settings produces the same material; leave it empty for a different result each time.","group":"Settings","label":"Seed","max":2147483647,"min":0,"name":"seed","costImpact":false,"type":"number"}],"uiConfig":{"selects":{"upscaleFactor":{"0":"None","2":"2x","4":"4x"},"tilingMode":{"horizontal":"Horizontal","vertical":"Vertical","both":"Both"},"maps":{"basecolor":"Base Color","metalness":"Metalness","roughness":"Roughness","height":"Height","normal":"Normal"}},"resolutionComponent":{"widthInput":"width","label":"Dimensions","heightInput":"height","presets":[{"width":512,"label":"1:1 (512x512)","height":512},{"label":"1:1 (1024x1024)","height":1024,"width":1024},{"height":2048,"label":"1:1 (2048x2048)","width":2048},{"label":"4:3 (1024x768)","width":1024,"height":768},{"label":"3:4 (768x1024)","width":768,"height":1024},{"label":"1